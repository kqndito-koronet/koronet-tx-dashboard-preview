{
  "metadata": {
    "queries": {
      "order_types": {
        "sql": "SELECT COMPANY_NAME, ACCOUNT_ID, SUM(CASE WHEN ORDER_TYPE = 'Open Market' THEN SALES ELSE 0 END) as open_market_gmv, SUM(CASE WHEN ORDER_TYPE = 'Prebook' THEN SALES ELSE 0 END) as prebook_gmv, SUM(SALES) as total_sell_gmv FROM PRODUCTION.ANALYTICS.SALES_SV WHERE KS_FLAG = TRUE AND SHIPPING_DATE >= '2026-01-01' AND SHIPPING_DATE < '2026-07-01' AND SALES < 100000 GROUP BY COMPANY_NAME, ACCOUNT_ID ORDER BY total_sell_gmv DESC",
        "source": "PRODUCTION.ANALYTICS.SALES_SV",
        "rows": 339,
        "filters": "ks_flag=TRUE, shipping_date H1 2026, sales < 100000"
      },
      "anticipation": {
        "sql": "SELECT COMPANY_NAME, ACCOUNT_ID, COUNT(DISTINCT CASE WHEN DATEDIFF('day', ARRIVAL_DATE, SHIPPING_DATE) <= 3 THEN PURCHASE_ORDER_ITEM_ID END) as orders_0_3d, COUNT(DISTINCT CASE WHEN DATEDIFF('day', ARRIVAL_DATE, SHIPPING_DATE) BETWEEN 4 AND 7 THEN PURCHASE_ORDER_ITEM_ID END) as orders_4_7d, COUNT(DISTINCT CASE WHEN DATEDIFF('day', ARRIVAL_DATE, SHIPPING_DATE) BETWEEN 8 AND 14 THEN PURCHASE_ORDER_ITEM_ID END) as orders_8_14d, COUNT(DISTINCT CASE WHEN DATEDIFF('day', ARRIVAL_DATE, SHIPPING_DATE) BETWEEN 15 AND 30 THEN PURCHASE_ORDER_ITEM_ID END) as orders_15_30d, COUNT(DISTINCT CASE WHEN DATEDIFF('day', ARRIVAL_DATE, SHIPPING_DATE) > 30 THEN PURCHASE_ORDER_ITEM_ID END) as orders_30plus_d, COUNT(DISTINCT PURCHASE_ORDER_ITEM_ID) as total_orders FROM PRODUCTION.ANALYTICS.PROCUREMENTS_SV WHERE KS_FLAG = TRUE AND SHIPPING_DATE >= '2026-01-01' AND SHIPPING_DATE < '2026-07-01' GROUP BY COMPANY_NAME, ACCOUNT_ID ORDER BY total_orders DESC",
        "source": "PRODUCTION.ANALYTICS.PROCUREMENTS_SV",
        "rows": 318,
        "filters": "ks_flag=TRUE, shipping_date H1 2026",
        "note": "CREATED_DATE and ORDER_DATE do not exist in PROCUREMENTS_SV. Used ARRIVAL_DATE instead. This measures arrival-to-shipping gap (logistics lead time), NOT order-creation anticipation. Interpret as 'how far ahead does product arrive before it ships to customer' rather than 'how far ahead did they place the order'."
      }
    },
    "date": "2026-07-30",
    "data_rules_applied": ["R1: ks_flag=TRUE", "R4: sales < 100000", "R8: semantic views only (*_SV)", "R9: provenance on every number", "R15: PROCUREMENTS_SV confirmed fields"]
  },
